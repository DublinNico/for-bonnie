{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:py": "cd .. && python -m pytest",
    "test:integration": "next build && vitest run -c vitest.integration.config.mts",
    "test:security": "next build && vitest run -c vitest.security.config.mts"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "happy-dom": "^21.0.4",
    "supertest": "^7.3.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
